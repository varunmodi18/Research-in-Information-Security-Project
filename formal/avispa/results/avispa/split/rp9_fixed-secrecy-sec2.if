%% IF specification of rp9_fixed.hlpsl

section signature:

state_basestation: agent * agent * agent * public_key * symmetric_key * nat * text * text * text * text * text * text * text * text * text * text * text * text * text * text * text * public_key * public_key * hash_func * set(text) * set(agent) * nat -> fact
state_clusterhead: agent * agent * agent * public_key * symmetric_key * nat * text * text * text * text * text * text * text * text * text * text * text * text * text * text * text * public_key * public_key * hash_func * set(text) * set(agent) * set(text) * set(agent) * nat -> fact
state_clustermember: agent * agent * agent * public_key * symmetric_key * nat * text * text * text * text * text * text * text * text * text * text * text * text * text * text * text * public_key * public_key * hash_func * set(text) * set(agent) * nat -> fact


section types:

s, S: symmetric_key
MGoal, start: message
F, dummy_hash: hash_func
Dummy_Set_76, Set_111, Set_79, Set_76, Set_40, Dummy_Set_40, Dummy_Set_79, Dummy_Set_111: set(text)
Set_80, Set_77, Dummy_Set_77, ASGoal, Dummy_Set_112, Dummy_Set_41, Dummy_Set_80, Set_112, Set_41: set(agent)
cm, CM, i, ch, CH, A2Goal, bs, BS, A1Goal: agent
sec3, em1, sec2, em3, sec1, em2: protocol_id
set_182, set_188, set_185, set_180, set_141, set_160, set_195, set_159, set_190, set_181, set_192, set_172, set_193, set_187, set_161, set_142, set_194, set_171, set_178, set_191, set_184, set_162, set_177, set_179: set
11, 4, State, 7, SID2, 9, 6, SID, 8, 13, 1, 10, 3, 5, SID1, Dummy_State, 0, 2: nat
Pubs, pucm, Pucm, puch, Puch, pubs, dummy_pk: public_key
Idcm, Pcm, Rch, A4, Rcm, Nch, G, A1, Dummy_Rch, Pch, Dummy_Nch, Idbs, A3, Dummy_A2, A2, Ncm, dummy_nonce, Pac, Idch, Dummy_Pch, Dummy_A1, Dummy_Rcm, Dummy_A3, Dummy_A4, Dummy_Pcm, Dummy_Ncm: text


section inits:

initial_state init1 := 
 iknows(start).
 iknows(cm).
 iknows(ch).
 iknows(bs).
 iknows(pucm).
 iknows(puch).
 iknows(pubs).
 iknows(i).
 state_clustermember(cm,ch,bs,pubs,s,0,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_pk,dummy_pk,dummy_hash,set_141,set_142,3).
 state_clusterhead(ch,cm,bs,pubs,s,1,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_pk,dummy_pk,dummy_hash,set_159,set_160,set_161,set_162,4).
 state_basestation(bs,cm,ch,pubs,s,6,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_pk,dummy_pk,dummy_hash,set_171,set_172,5).
 state_clusterhead(ch,i,bs,pubs,s,1,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_pk,dummy_pk,dummy_hash,set_179,set_180,set_181,set_182,8).
 state_basestation(bs,i,ch,pubs,s,6,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_pk,dummy_pk,dummy_hash,set_184,set_185,9).
 state_clustermember(cm,i,bs,pubs,s,0,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_pk,dummy_pk,dummy_hash,set_187,set_188,11).
 state_basestation(bs,cm,i,pubs,s,6,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_nonce,dummy_pk,dummy_pk,dummy_hash,set_194,set_195,13)


section rules:

step step_0 (CM,CH,BS,Pubs,S,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Dummy_Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_40,Dummy_Set_41,SID,Pcm) :=
 state_clustermember(CM,CH,BS,Pubs,S,0,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Dummy_Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_40,Dummy_Set_41,SID).
 iknows(scrypt(S,Pcm))
 =>
 state_clustermember(CM,CH,BS,Pubs,S,2,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_40,Dummy_Set_41,SID).
 secret(Dummy_Set_40,sec2,Dummy_Set_41).
 contains(Idch,Dummy_Set_40).
 contains(Idcm,Dummy_Set_40).
 contains(G,Dummy_Set_40).
 contains(CH,Dummy_Set_41).
 contains(CM,Dummy_Set_41)

step step_1 (CM,CH,BS,Pubs,S,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Dummy_Ncm,Pch,Pcm,Rch,Dummy_Rcm,Dummy_A1,Dummy_A2,Dummy_A3,Dummy_A4,Puch,Pucm,F,Set_40,Set_41,SID,Nch,Ncm,Rcm,A1,A2) :=
 state_clustermember(CM,CH,BS,Pubs,S,2,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Dummy_Ncm,Pch,Pcm,Rch,Dummy_Rcm,Dummy_A1,Dummy_A2,Dummy_A3,Dummy_A4,Puch,Pucm,F,Set_40,Set_41,SID).
 iknows(crypt(Pucm,pair(A1,pair(A2,Nch))))
=[exists Ncm,Rcm]=>
 state_clustermember(CM,CH,BS,Pubs,S,4,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,apply(F,pair(Rcm,G)),apply(F,pair(Rcm,Pcm)),Puch,Pucm,F,Set_40,Set_41,SID).
 iknows(crypt(Puch,pair(apply(F,pair(Rcm,G)),pair(apply(F,pair(Rcm,Pcm)),Ncm))))

step step_2 (CH,CM,BS,Pubs,S,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Set_76,Set_77,Set_79,Set_80,SID) :=
 state_clusterhead(CH,CM,BS,Pubs,S,1,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Set_76,Set_77,Set_79,Set_80,SID).
 iknows(start)
 =>
 state_clusterhead(CH,CM,BS,Pubs,S,3,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Set_76,Set_77,Set_79,Set_80,SID).
 iknows(scrypt(S,Pac))

step step_3 (CH,CM,BS,Pubs,S,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Dummy_Pch,Dummy_Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_76,Dummy_Set_77,Set_79,Set_80,SID,Pch,Pcm) :=
 state_clusterhead(CH,CM,BS,Pubs,S,3,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Dummy_Pch,Dummy_Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_76,Dummy_Set_77,Set_79,Set_80,SID).
 iknows(scrypt(S,pair(Pch,Pcm)))
 =>
 state_clusterhead(CH,CM,BS,Pubs,S,5,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_76,Dummy_Set_77,Set_79,Set_80,SID).
 secret(Dummy_Set_76,sec2,Dummy_Set_77).
 contains(Idbs,Dummy_Set_76).
 contains(Idch,Dummy_Set_76).
 contains(Idcm,Dummy_Set_76).
 contains(G,Dummy_Set_76).
 contains(CH,Dummy_Set_77).
 contains(BS,Dummy_Set_77)

step step_4 (CH,CM,BS,Pubs,S,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Ncm,Pch,Dummy_Pcm,Dummy_Rch,Rcm,Dummy_A1,Dummy_A2,A3,A4,Puch,Pucm,F,Set_76,Set_77,Dummy_Set_79,Dummy_Set_80,SID,Nch,Pcm,Rch) :=
 state_clusterhead(CH,CM,BS,Pubs,S,5,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Ncm,Pch,Dummy_Pcm,Dummy_Rch,Rcm,Dummy_A1,Dummy_A2,A3,A4,Puch,Pucm,F,Set_76,Set_77,Dummy_Set_79,Dummy_Set_80,SID).
 iknows(scrypt(S,Pcm))
=[exists Nch,Rch]=>
 state_clusterhead(CH,CM,BS,Pubs,S,7,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,apply(F,pair(Rch,G)),apply(F,pair(Rch,Pch)),A3,A4,Puch,Pucm,F,Set_76,Set_77,Dummy_Set_79,Dummy_Set_80,SID).
 secret(Dummy_Set_79,sec2,Dummy_Set_80).
 iknows(crypt(Pucm,pair(apply(F,pair(Rch,G)),pair(apply(F,pair(Rch,Pch)),Nch)))).
 contains(Idch,Dummy_Set_79).
 contains(Idcm,Dummy_Set_79).
 contains(G,Dummy_Set_79).
 contains(CH,Dummy_Set_80).
 contains(CM,Dummy_Set_80)

step step_5 (CH,CM,BS,Pubs,S,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Dummy_Ncm,Pch,Pcm,Rch,Rcm,A1,A2,Dummy_A3,Dummy_A4,Puch,Pucm,F,Set_76,Set_77,Set_79,Set_80,SID,Nch,Ncm,A3,A4) :=
 state_clusterhead(CH,CM,BS,Pubs,S,7,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Dummy_Ncm,Pch,Pcm,Rch,Rcm,A1,A2,Dummy_A3,Dummy_A4,Puch,Pucm,F,Set_76,Set_77,Set_79,Set_80,SID).
 iknows(crypt(Puch,pair(A3,pair(A4,Nch))))
=[exists Ncm]=>
 state_clusterhead(CH,CM,BS,Pubs,S,9,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Set_76,Set_77,Set_79,Set_80,SID).
 iknows(crypt(Pubs,pair(A1,pair(A2,Nch))))

step step_6 (BS,CM,CH,Pubs,S,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Dummy_Pch,Dummy_Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_111,Dummy_Set_112,SID) :=
 state_basestation(BS,CM,CH,Pubs,S,6,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Dummy_Pch,Dummy_Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_111,Dummy_Set_112,SID).
 iknows(scrypt(S,Pac))
 =>
 state_basestation(BS,CM,CH,Pubs,S,8,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,apply(F,pair(xor(Idbs,Idch),G)),apply(F,pair(xor(Idch,Idcm),G)),Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Dummy_Set_111,Dummy_Set_112,SID).
 secret(Dummy_Set_111,sec2,Dummy_Set_112).
 iknows(scrypt(S,pair(apply(F,pair(xor(Idbs,Idch),G)),apply(F,pair(xor(Idch,Idcm),G))))).
 contains(Idbs,Dummy_Set_111).
 contains(Idch,Dummy_Set_111).
 contains(Idcm,Dummy_Set_111).
 contains(G,Dummy_Set_111).
 contains(CH,Dummy_Set_112).
 contains(BS,Dummy_Set_112)

step step_7 (BS,CM,CH,Pubs,S,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Ncm,Pch,Pcm,Rch,Rcm,Dummy_A1,Dummy_A2,A3,A4,Puch,Pucm,F,Set_111,Set_112,SID,Nch,A1,A2) :=
 state_basestation(BS,CM,CH,Pubs,S,8,Pac,Idcm,Idch,Idbs,G,Dummy_Nch,Ncm,Pch,Pcm,Rch,Rcm,Dummy_A1,Dummy_A2,A3,A4,Puch,Pucm,F,Set_111,Set_112,SID).
 iknows(crypt(Pubs,pair(A1,pair(A2,Nch))))
 =>
 state_basestation(BS,CM,CH,Pubs,S,10,Pac,Idcm,Idch,Idbs,G,Nch,Ncm,Pch,Pcm,Rch,Rcm,A1,A2,A3,A4,Puch,Pucm,F,Set_111,Set_112,SID)


section properties:

property secrecy_of_sec2 (MGoal,ASGoal) :=
 [] ((secret(MGoal,sec2,ASGoal) /\ iknows(MGoal))
     => contains(i,ASGoal))


section attack_states:

attack_state secrecy_of_sec2 (MGoal,ASGoal) :=
 iknows(MGoal).
 secret(MGoal,sec2,ASGoal) &
 not(contains(i,ASGoal))

