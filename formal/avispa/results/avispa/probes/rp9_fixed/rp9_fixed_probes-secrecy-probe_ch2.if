section properties:

property secrecy_of_probe_ch2 (MGoal,ASGoal) :=
 [] ((secret(MGoal,probe_ch2,ASGoal) /\ iknows(MGoal))
     => contains(i,ASGoal))


section attack_states:

attack_state secrecy_of_probe_ch2 (MGoal,ASGoal) :=
 iknows(MGoal).
 secret(MGoal,probe_ch2,ASGoal) &
 not(contains(i,ASGoal))

