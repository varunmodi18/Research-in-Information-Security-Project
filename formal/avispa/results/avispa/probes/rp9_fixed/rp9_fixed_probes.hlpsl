%% PER-TRANSITION EXECUTABILITY PROBE (instrumentation only, generated by probes.py)
%% RP9 (Harbi et al., Ad Hoc Networks 94 (2019) 101948) Figs. 4-8 with ONLY the fixes that an AVISPA
%% tool rejects (follow-up Part C2.2). Each change is marked "FIX Dn"; nothing else differs from
%% rp9_transcribed.hlpsl. Results: formal/avispa/README.md and results/avispa/.
%%
%%  D1 request(...) on the left of =|> (Figs. 4 and 5): CL-AtSe refuses the translated file
%%     ("request in left-hand side."); OFMC accepts it. Moved to the right-hand side.
%%  D8 `hash_func` (the type of F) is unknown to the original AVISPA translator (hlpsl2if 2.0 of the
%%     32-bit SPAN 1.6 package: "Syn.Err(10): missing or invalid type"); the later translator of the
%%     64-bit package accepts it. Written `function`, the older spelling, so both translators accept it.
%%
%% Defects D2-D7 and D9 are NOT fixed here: no tool rejects them. They make the authentication phase
%% unexecutable (see rp9_executable.hlpsl and the executability probes in results/avispa/).

%% ---- Fig. 4 -------------------------------------------------------------------------------
role clustermember(CM,CH,BS:agent,
                   Pubs:public_key,
                   S:symmetric_key,
                   SND,RCV:channel(dy))
played_by CM
def=
        local
                State:nat,
                Probe_cm1,Probe_cm2,Probe_ch1,Probe_ch2,Probe_ch3,Probe_ch4,Probe_bs1,Probe_bs2:text,
                Pac,Idcm,Idch,Idbs,G,Nch,Ncm:text,
                Pch,Pcm,Rch,Rcm,A1,A2,A3,A4:text,
                Puch,Pucm:public_key,
                F: function                              %% FIX D8: hash_func -> function
        const   em1,em2,em3,sec1,sec2,sec3,probe_cm1,probe_cm2,probe_ch1,probe_ch2,probe_ch3,probe_ch4,probe_bs1,probe_bs2:protocol_id
        init
                State := 0
        transition
                1. State=0 /\ RCV({Pcm'}_S)  =|>
                   State':=2 /\ Probe_cm1':=new() /\ SND(Probe_cm1') /\ secret(Probe_cm1',probe_cm1,{CM}) /\ secret({Idch,Idcm,G},sec2,{CH,CM})
                2. State=2 /\ RCV({A1'.A2'.Nch'}_Pucm) =|>
                   State':=4 /\ Probe_cm2':=new() /\ SND(Probe_cm2') /\ secret(Probe_cm2',probe_cm2,{CM}) /\ request(CM,CH,em2,Nch')      %% FIX D1: request moved right
                   /\ Rcm':=new()
                   /\ Ncm':=new() /\ A3':=F(Rcm'.G) /\ A4':=F(Rcm'.Pcm)
                   /\ SND({A3'.A4'.Ncm'}_Puch) /\ witness(CM,CH,em3,Ncm')
end role

%% ---- Fig. 5 -------------------------------------------------------------------------------
role clusterhead(CM,CH,BS:agent,
                 Pubs:public_key,
                 S:symmetric_key,
                 SND,RCV:channel(dy))
played_by CH
def=
        local
                State:nat,
                Probe_cm1,Probe_cm2,Probe_ch1,Probe_ch2,Probe_ch3,Probe_ch4,Probe_bs1,Probe_bs2:text,
                Pac,Idcm,Idch,Idbs,G,Nch,Ncm:text,
                Pch,Pcm,Rch,Rcm,A1,A2,A3,A4:text,
                Puch,Pucm:public_key,
                F: function                              %% FIX D8: hash_func -> function
        const   em1,em2,em3,sec1,sec2,sec3,probe_cm1,probe_cm2,probe_ch1,probe_ch2,probe_ch3,probe_ch4,probe_bs1,probe_bs2:protocol_id
        init
                State := 1
        transition
                1. State=1 /\ RCV(start) =|>
                   State':=3 /\ Probe_ch1':=new() /\ SND(Probe_ch1') /\ secret(Probe_ch1',probe_ch1,{CH}) /\ SND({Pac}_S) /\ secret(Pac,sec1,CH)
                2. State=3 /\ RCV({Pch'.Pcm'}_S)  =|>
                   State':=5 /\ Probe_ch2':=new() /\ SND(Probe_ch2') /\ secret(Probe_ch2',probe_ch2,{CH}) /\ secret({Idbs,Idch,Idcm,G},sec2,{CH,BS})
                3. State=5 /\ SND({Pcm'}_S) =|>
                   State':=7 /\ Probe_ch3':=new() /\ SND(Probe_ch3') /\ secret(Probe_ch3',probe_ch3,{CH}) /\ secret({Idch,Idcm,G},sec2,{CH,CM}) /\ Rch':=new()
                   /\ Nch':=new() /\ A1':=F(Rch'.G) /\ A2':=F(Rch'.Pch)
                   /\ SND({A1'.A2'.Nch'}_Pucm) /\ witness(CH,CM,em2,Nch')
                4. State=7 /\ RCV({A3'.A4'.Nch'}_Puch) =|>
                   State':=9 /\ Probe_ch4':=new() /\ SND(Probe_ch4') /\ secret(Probe_ch4',probe_ch4,{CH}) /\ request(CH,CM,em3,Ncm')      %% FIX D1: request moved right
                   /\ SND({A1.A2.Nch'}_Pubs) /\ witness(CH,BS,em1,Nch')
end role

%% ---- Fig. 6 -------------------------------------------------------------------------------
role basestation(CM,CH,BS:agent,
                 Pubs:public_key,
                 S:symmetric_key,
                 SND,RCV:channel(dy))
played_by BS
def=
        local
                State:nat,
                Probe_cm1,Probe_cm2,Probe_ch1,Probe_ch2,Probe_ch3,Probe_ch4,Probe_bs1,Probe_bs2:text,
                Pac,Idcm,Idch,Idbs,G,Nch,Ncm:text,
                Pch,Pcm,Rch,Rcm,A1,A2,A3,A4:text,
                Puch,Pucm:public_key,
                F: function                              %% FIX D8: hash_func -> function
        const   em1,em2,em3,sec1,sec2,sec3,probe_cm1,probe_cm2,probe_ch1,probe_ch2,probe_ch3,probe_ch4,probe_bs1,probe_bs2:protocol_id
        init
                State := 6
        transition
                1. State=6 /\ RCV({Pac}_S) =|>
                   State':=8 /\ Probe_bs1':=new() /\ SND(Probe_bs1') /\ secret(Probe_bs1',probe_bs1,{BS}) /\ secret(Pac,sec1,CH) /\ Pch':= F(xor(Idbs,Idch).G)
                   /\ Pcm':= F(xor(Idch,Idcm).G) /\ secret({Idbs,Idch,Idcm,G},sec2,{CH,BS})
                   /\ SND({Pch'.Pcm'}_S)
                2. State=8 /\ RCV({A1'.A2'.Nch'}_Pubs) =|>
                   State':=10 /\ Probe_bs2':=new() /\ SND(Probe_bs2') /\ secret(Probe_bs2',probe_bs2,{BS}) /\ request(CH,BS,em1,Nch')
end role

%% ---- Fig. 7 -------------------------------------------------------------------------------
role session(CM,CH,BS:agent,
             Pubs:public_key,
             S:symmetric_key)
def=
        local
                SndCM,RcvCM,SndCH,RcvCH,SndBS,RcvBS:channel(dy)
        composition
                clustermember(CM,CH,BS,Pubs,S,SndCM,RcvCM)
             /\ clusterhead(CM,CH,BS,Pubs,S,SndCH,RcvCH)
             /\ basestation(CM,CH,BS,Pubs,S,SndBS,RcvBS)
end role

%% ---- Fig. 8 -------------------------------------------------------------------------------
role environment()
def=
        const
                cm,ch,bs:agent,
                pubs,puch,pucm:public_key,
                s:symmetric_key,
                em1,em2,em3,sec1,sec2,sec3,probe_cm1,probe_cm2,probe_ch1,probe_ch2,probe_ch3,probe_ch4,probe_bs1,probe_bs2:protocol_id

        intruder_knowledge = {cm,ch,bs,pucm,puch,pubs}
        composition
                session(cm,ch,bs,pubs,s)
             /\ session(i,ch,bs,pubs,s)
             /\ session(cm,i,bs,pubs,s)
end role

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

goal
        secrecy_of probe_cm1
        secrecy_of probe_cm2
        secrecy_of probe_ch1
        secrecy_of probe_ch2
        secrecy_of probe_ch3
        secrecy_of probe_ch4
        secrecy_of probe_bs1
        secrecy_of probe_bs2
        secrecy_of sec1
        secrecy_of sec2
        secrecy_of sec3
        authentication_on em1
        authentication_on em2
        authentication_on em3
end goal

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

environment()
