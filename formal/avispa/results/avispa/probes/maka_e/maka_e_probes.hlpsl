%% PER-TRANSITION EXECUTABILITY PROBE (instrumentation only, generated by probes.py)
%% MAKA-E v1 authenticated key exchange (IMPLEMENTATION_PLAN.md §4.6.4, M7-T2; follow-up Part C2.4).
%%
%% One purpose at a time (the same message flow serves CH-BS, CM-BS and CM-CH; the purpose P is bound
%% into the transcript and the key derivation). Roles: initiator Ini, responder Rsp. Abstractions:
%%   PSK_AB          -> a symmetric_key constant per pair: kab for the honest pair; the intruder holds
%%                      kib and kai, the PSKs of the pairs it belongs to. The SOK derivation
%%                      e(Pr_A, H(ID_B)) and the BDH assumption behind it are not modelled; they are
%%                      argued in docs/SECURITY_ARGUMENT.md.
%%   X = x*g, Z      -> exp(G,X), exp(exp(G,X),Y)   (the tools' Diffie-Hellman algebra)
%%   HKDF, HMAC, H   -> the hash function H with distinct, PUBLIC label constants
%%
%% HS1 Ini->Rsp: Sid.Ini.Rsp.P.Ni.exp(G,X)
%% HS2 Rsp->Ini: Sid.Rsp.Ini.Nr.exp(G,Y).TagR     TagR = H(KcR.hs2.Th)
%% HS3 Ini->Rsp: Sid.TagI                         TagI = H(KcI.hs3.Th)
%% Th = H(HS1.Sid.Rsp.Ini.Nr.exp(G,Y)); Kc*/K* = H(label.PSK.Z.Th.P)
%% Sessions: honest-honest; a second, parallel honest session; intruder as initiator with its own
%% PSK (kib); intruder as responder with its own PSK (kai).
%% Goals: authentication on both nonces; secrecy of both session keys.
%%
%% Change history (2026-10-06, when the model first went through the real AVISPA tools). None of
%% these weakens the model; each makes the analysis meaningful:
%%  1. PSKs were psk(A,B) with psk:function. In the typed model the application does not have type
%%     symmetric_key, so CL-AtSe eliminated every step and reported SAFE after 0 states (vacuous).
%%     Per-pair symmetric_key constants are the standard AVISPA idiom for the same knowledge.
%%  2. The HKDF/HMAC labels (kcr, kci, kir, kri, hs2, hs3) were role constants unknown to the intruder,
%%     so they acted as hidden secrets: the negative control (no PSK) was then also "SAFE". They are
%%     public strings and are now in the intruder's knowledge; the control is attacked as it must be.
%%  3. The role parameters I and R are named Ini and Rsp: OFMC (2006/02/13) aborts with "ofmc: I" on
%%     the IF otherwise. Pure renaming.

role initiator(Ini,Rsp:agent, Psk:symmetric_key, G,P:text, H:hash_func, SND,RCV:channel(dy))
played_by Ini
def=
        local
                State:nat,
                Probe_i1,Probe_i2,Probe_r1,Probe_r2:text,
                Sid,Ni,Nr,X:text,
                GY:message,
                Th,Kir,Kri:message
        const   kcr,kci,kir,kri,hs2,hs3:text,
                n_i,n_r,k_ir,k_ri,probe_i1,probe_i2,probe_r1,probe_r2:protocol_id
        init
                State := 0
        transition
                1. State=0 /\ RCV(start) =|>
                   State':=1 /\ Probe_i1':=new() /\ SND(Probe_i1') /\ secret(Probe_i1',probe_i1,{Ini}) /\ Sid':=new() /\ Ni':=new() /\ X':=new()
                   /\ SND(Sid'.Ini.Rsp.P.Ni'.exp(G,X'))
                   /\ witness(Ini,Rsp,n_i,Ni')
                2. State=1 /\ RCV(Sid.Rsp.Ini.Nr'.GY'.
                        H(H(kcr.Psk.exp(GY',X).H(Sid.Ini.Rsp.P.Ni.exp(G,X).Sid.Rsp.Ini.Nr'.GY').P).hs2.
                          H(Sid.Ini.Rsp.P.Ni.exp(G,X).Sid.Rsp.Ini.Nr'.GY'))) =|>
                   State':=2 /\ Probe_i2':=new() /\ SND(Probe_i2') /\ secret(Probe_i2',probe_i2,{Ini}) /\ Th':=H(Sid.Ini.Rsp.P.Ni.exp(G,X).Sid.Rsp.Ini.Nr'.GY')
                   /\ Kir':=H(kir.Psk.exp(GY',X).Th'.P) /\ Kri':=H(kri.Psk.exp(GY',X).Th'.P)
                   /\ SND(Sid.H(H(kci.Psk.exp(GY',X).Th'.P).hs3.Th'))
                   /\ request(Ini,Rsp,n_r,Nr')
                   /\ secret(Kir',k_ir,{Ini,Rsp}) /\ secret(Kri',k_ri,{Ini,Rsp})
end role

role responder(Ini,Rsp:agent, Psk:symmetric_key, G,P:text, H:hash_func, SND,RCV:channel(dy))
played_by Rsp
def=
        local
                State:nat,
                Probe_i1,Probe_i2,Probe_r1,Probe_r2:text,
                Sid,Ni,Nr,Y:text,
                GX:message,
                Th,Kir,Kri:message
        const   kcr,kci,kir,kri,hs2,hs3:text,
                n_i,n_r,k_ir,k_ri,probe_i1,probe_i2,probe_r1,probe_r2:protocol_id
        init
                State := 0
        transition
                1. State=0 /\ RCV(Sid'.Ini.Rsp.P.Ni'.GX') =|>
                   State':=1 /\ Probe_r1':=new() /\ SND(Probe_r1') /\ secret(Probe_r1',probe_r1,{Rsp}) /\ Nr':=new() /\ Y':=new()
                   /\ Th':=H(Sid'.Ini.Rsp.P.Ni'.GX'.Sid'.Rsp.Ini.Nr'.exp(G,Y'))
                   /\ SND(Sid'.Rsp.Ini.Nr'.exp(G,Y').H(H(kcr.Psk.exp(GX',Y').Th'.P).hs2.Th'))
                   /\ witness(Rsp,Ini,n_r,Nr')
                2. State=1 /\ RCV(Sid.H(H(kci.Psk.exp(GX,Y).Th.P).hs3.Th)) =|>
                   State':=2 /\ Probe_r2':=new() /\ SND(Probe_r2') /\ secret(Probe_r2',probe_r2,{Rsp}) /\ Kir':=H(kir.Psk.exp(GX,Y).Th.P) /\ Kri':=H(kri.Psk.exp(GX,Y).Th.P)
                   /\ request(Rsp,Ini,n_i,Ni)
                   /\ secret(Kir',k_ir,{Ini,Rsp}) /\ secret(Kri',k_ri,{Ini,Rsp})
end role

role session(Ini,Rsp:agent, Psk:symmetric_key, G,P:text, H:hash_func)
def=
        local   SI,RI,SR,RR:channel(dy)
        composition
                initiator(Ini,Rsp,Psk,G,P,H,SI,RI) /\ responder(Ini,Rsp,Psk,G,P,H,SR,RR)
end role

role environment()
def=
        const   a,b:agent,
                kab,kib,kai:symmetric_key,
                g,cm_ch:text,
                kcr,kci,kir,kri,hs2,hs3:text,
                h:hash_func,
                n_i,n_r,k_ir,k_ri,probe_i1,probe_i2,probe_r1,probe_r2:protocol_id
        %% the HKDF/HMAC labels are public strings: the intruder knows them
        intruder_knowledge = {a,b,g,cm_ch,h,kib,kai,kcr,kci,kir,kri,hs2,hs3}
        composition
                session(a,b,kab,g,cm_ch,h)               %% honest - honest
             /\ session(a,b,kab,g,cm_ch,h)               %% a second, parallel honest session
             /\ session(i,b,kib,g,cm_ch,h)               %% intruder as initiator, own PSK with b
             /\ session(a,i,kai,g,cm_ch,h)               %% intruder as responder, own PSK with a
end role

goal
        secrecy_of probe_i1
        secrecy_of probe_i2
        secrecy_of probe_r1
        secrecy_of probe_r2
        authentication_on n_i
        authentication_on n_r
        secrecy_of k_ir, k_ri
end goal

environment()
