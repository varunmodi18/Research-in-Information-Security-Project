section rules:

step step_0 (Ini,Rsp,Psk,G,P,H,Dummy_Probe_i1,Probe_i2,Probe_r1,Probe_r2,Dummy_Sid,Dummy_Ni,Nr,Dummy_X,GY,Th,Kir,Kri,Dummy_Set_43,Set_47,Set_49,Set_50,SID,Probe_i1,Sid,Ni,X) :=
 state_initiator(Ini,Rsp,Psk,G,P,H,0,Dummy_Probe_i1,Probe_i2,Probe_r1,Probe_r2,Dummy_Sid,Dummy_Ni,Nr,Dummy_X,GY,Th,Kir,Kri,Dummy_Set_43,Set_47,Set_49,Set_50,SID).
 iknows(start)
=[exists X,Ni,Sid,Probe_i1]=>
 state_initiator(Ini,Rsp,Psk,G,P,H,1,Probe_i1,Probe_i2,Probe_r1,Probe_r2,Sid,Ni,Nr,X,GY,Th,Kir,Kri,Dummy_Set_43,Set_47,Set_49,Set_50,SID).
 iknows(Probe_i1).
 iknows(pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,exp(G,X))))))).
 contains(Ini,Dummy_Set_43)

step step_1 (Ini,Rsp,Psk,G,P,H,Probe_i1,Dummy_Probe_i2,Probe_r1,Probe_r2,Sid,Ni,Dummy_Nr,X,Dummy_GY,Dummy_Th,Dummy_Kir,Dummy_Kri,Set_43,Dummy_Set_47,Dummy_Set_49,Dummy_Set_50,SID,Probe_i2,Nr,GY) :=
 state_initiator(Ini,Rsp,Psk,G,P,H,1,Probe_i1,Dummy_Probe_i2,Probe_r1,Probe_r2,Sid,Ni,Dummy_Nr,X,Dummy_GY,Dummy_Th,Dummy_Kir,Dummy_Kri,Set_43,Dummy_Set_47,Dummy_Set_49,Dummy_Set_50,SID).
 iknows(pair(Sid,pair(Rsp,pair(Ini,pair(Nr,pair(GY,apply(H,pair(apply(H,pair(kcr,pair(exp(GY,X),pair(apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(exp(G,X),pair(Sid,pair(Rsp,pair(Ini,pair(Nr,GY))))))))))),P)))),pair(hs2,apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(exp(G,X),pair(Sid,pair(Rsp,pair(Ini,pair(Nr,GY))))))))))))))))))))
=[exists Probe_i2]=>
 state_initiator(Ini,Rsp,Psk,G,P,H,2,Probe_i1,Probe_i2,Probe_r1,Probe_r2,Sid,Ni,Nr,X,GY,apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(exp(G,X),pair(Sid,pair(Rsp,pair(Ini,pair(Nr,GY))))))))))),apply(H,pair(kir,pair(exp(GY,X),pair(apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(exp(G,X),pair(Sid,pair(Rsp,pair(Ini,pair(Nr,GY))))))))))),P)))),apply(H,pair(kri,pair(exp(GY,X),pair(apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(exp(G,X),pair(Sid,pair(Rsp,pair(Ini,pair(Nr,GY))))))))))),P)))),Set_43,Dummy_Set_47,Dummy_Set_49,Dummy_Set_50,SID).
 iknows(Probe_i2).
 iknows(pair(Sid,apply(H,pair(apply(H,pair(kci,pair(exp(GY,X),pair(apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(exp(G,X),pair(Sid,pair(Rsp,pair(Ini,pair(Nr,GY))))))))))),P)))),pair(hs3,apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(exp(G,X),pair(Sid,pair(Rsp,pair(Ini,pair(Nr,GY)))))))))))))))).
 contains(Ini,Dummy_Set_47).
 contains(Ini,Dummy_Set_49).
 contains(Rsp,Dummy_Set_49).
 contains(Ini,Dummy_Set_50).
 contains(Rsp,Dummy_Set_50)

step step_2 (Rsp,Ini,Psk,G,P,H,Probe_i1,Probe_i2,Dummy_Probe_r1,Probe_r2,Dummy_Sid,Dummy_Ni,Dummy_Nr,Dummy_Y,Dummy_GX,Dummy_Th,Kir,Kri,Dummy_Set_73,Set_74,Set_75,Set_76,SID,Probe_r1,Sid,Ni,Nr,Y,GX) :=
