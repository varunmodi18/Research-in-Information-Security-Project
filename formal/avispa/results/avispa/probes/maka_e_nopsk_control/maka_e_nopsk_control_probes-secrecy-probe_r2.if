 iknows(pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,GX))))))
=[exists Y,Nr,Probe_r1]=>
 state_responder(Rsp,Ini,Psk,G,P,H,1,Probe_i1,Probe_i2,Probe_r1,Probe_r2,Sid,Ni,Nr,Y,GX,apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(GX,pair(Sid,pair(Rsp,pair(Ini,pair(Nr,exp(G,Y)))))))))))),Kir,Kri,Dummy_Set_73,Set_74,Set_75,Set_76,SID).
 iknows(Probe_r1).
 iknows(pair(Sid,pair(Rsp,pair(Ini,pair(Nr,pair(exp(G,Y),apply(H,pair(apply(H,pair(kcr,pair(exp(GX,Y),pair(apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(GX,pair(Sid,pair(Rsp,pair(Ini,pair(Nr,exp(G,Y)))))))))))),P)))),pair(hs2,apply(H,pair(Sid,pair(Ini,pair(Rsp,pair(P,pair(Ni,pair(GX,pair(Sid,pair(Rsp,pair(Ini,pair(Nr,exp(G,Y))))))))))))))))))))).
 contains(Rsp,Dummy_Set_73)

step step_3 (Rsp,Ini,Psk,G,P,H,Probe_i1,Probe_i2,Probe_r1,Dummy_Probe_r2,Sid,Ni,Nr,Y,GX,Th,Dummy_Kir,Dummy_Kri,Set_73,Dummy_Set_74,Dummy_Set_75,Dummy_Set_76,SID,Probe_r2) :=
 state_responder(Rsp,Ini,Psk,G,P,H,1,Probe_i1,Probe_i2,Probe_r1,Dummy_Probe_r2,Sid,Ni,Nr,Y,GX,Th,Dummy_Kir,Dummy_Kri,Set_73,Dummy_Set_74,Dummy_Set_75,Dummy_Set_76,SID).
 iknows(pair(Sid,apply(H,pair(apply(H,pair(kci,pair(exp(GX,Y),pair(Th,P)))),pair(hs3,Th)))))
=[exists Probe_r2]=>
 state_responder(Rsp,Ini,Psk,G,P,H,2,Probe_i1,Probe_i2,Probe_r1,Probe_r2,Sid,Ni,Nr,Y,GX,Th,apply(H,pair(kir,pair(exp(GX,Y),pair(Th,P)))),apply(H,pair(kri,pair(exp(GX,Y),pair(Th,P)))),Set_73,Dummy_Set_74,Dummy_Set_75,Dummy_Set_76,SID).
 iknows(Probe_r2).
 secret(Probe_r2,probe_r2,Dummy_Set_74).
 contains(Rsp,Dummy_Set_74).
 contains(Ini,Dummy_Set_75).
 contains(Rsp,Dummy_Set_75).
 contains(Ini,Dummy_Set_76).
 contains(Rsp,Dummy_Set_76)


section properties:

property secrecy_of_probe_r2 (MGoal,ASGoal) :=
 [] ((secret(MGoal,probe_r2,ASGoal) /\ iknows(MGoal))
     => contains(i,ASGoal))


section attack_states:

attack_state secrecy_of_probe_r2 (MGoal,ASGoal) :=
 iknows(MGoal).
 secret(MGoal,probe_r2,ASGoal) &
 not(contains(i,ASGoal))

