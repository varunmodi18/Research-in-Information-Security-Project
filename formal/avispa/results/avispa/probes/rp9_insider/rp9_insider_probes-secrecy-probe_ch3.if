section properties:

property secrecy_of_probe_ch3 (MGoal,ASGoal) :=
 [] ((secret(MGoal,probe_ch3,ASGoal) /\ iknows(MGoal))
     => contains(i,ASGoal))


section attack_states:

attack_state secrecy_of_probe_ch3 (MGoal,ASGoal) :=
 iknows(MGoal).
 secret(MGoal,probe_ch3,ASGoal) &
 not(contains(i,ASGoal))

