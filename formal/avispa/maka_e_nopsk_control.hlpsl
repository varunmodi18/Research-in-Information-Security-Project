%% NEGATIVE CONTROL for maka_e.hlpsl (follow-up Part C2.5). Identical to maka_e.hlpsl except that the
%% PSK no longer enters the confirmation tags or the session-key derivation: the exchange is then plain
%% unauthenticated Diffie-Hellman. The back-ends MUST report an attack here; if they did not, the model
%% would not be sensitive to the property it claims, and its SAFE verdict would mean little.

role initiator(Ini,Rsp:agent, Psk:symmetric_key, G,P:text, H:hash_func, SND,RCV:channel(dy))
played_by Ini
def=
        local
                State:nat,
                Sid,Ni,Nr,X:text,
                GY:message,
                Th,Kir,Kri:message
        const   kcr,kci,kir,kri,hs2,hs3:text,
                n_i,n_r,k_ir,k_ri:protocol_id
        init
                State := 0
        transition
                1. State=0 /\ RCV(start) =|>
                   State':=1 /\ Sid':=new() /\ Ni':=new() /\ X':=new()
                   /\ SND(Sid'.Ini.Rsp.P.Ni'.exp(G,X'))
                   /\ witness(Ini,Rsp,n_i,Ni')
                2. State=1 /\ RCV(Sid.Rsp.Ini.Nr'.GY'.
                        H(H(kcr.exp(GY',X).H(Sid.Ini.Rsp.P.Ni.exp(G,X).Sid.Rsp.Ini.Nr'.GY').P).hs2.
                          H(Sid.Ini.Rsp.P.Ni.exp(G,X).Sid.Rsp.Ini.Nr'.GY'))) =|>
                   State':=2 /\ Th':=H(Sid.Ini.Rsp.P.Ni.exp(G,X).Sid.Rsp.Ini.Nr'.GY')
                   /\ Kir':=H(kir.exp(GY',X).Th'.P) /\ Kri':=H(kri.exp(GY',X).Th'.P)
                   /\ SND(Sid.H(H(kci.exp(GY',X).Th'.P).hs3.Th'))
                   /\ request(Ini,Rsp,n_r,Nr')
                   /\ secret(Kir',k_ir,{Ini,Rsp}) /\ secret(Kri',k_ri,{Ini,Rsp})
end role

role responder(Ini,Rsp:agent, Psk:symmetric_key, G,P:text, H:hash_func, SND,RCV:channel(dy))
played_by Rsp
def=
        local
                State:nat,
                Sid,Ni,Nr,Y:text,
                GX:message,
                Th,Kir,Kri:message
        const   kcr,kci,kir,kri,hs2,hs3:text,
                n_i,n_r,k_ir,k_ri:protocol_id
        init
                State := 0
        transition
                1. State=0 /\ RCV(Sid'.Ini.Rsp.P.Ni'.GX') =|>
                   State':=1 /\ Nr':=new() /\ Y':=new()
                   /\ Th':=H(Sid'.Ini.Rsp.P.Ni'.GX'.Sid'.Rsp.Ini.Nr'.exp(G,Y'))
                   /\ SND(Sid'.Rsp.Ini.Nr'.exp(G,Y').H(H(kcr.exp(GX',Y').Th'.P).hs2.Th'))
                   /\ witness(Rsp,Ini,n_r,Nr')
                2. State=1 /\ RCV(Sid.H(H(kci.exp(GX,Y).Th.P).hs3.Th)) =|>
                   State':=2 /\ Kir':=H(kir.exp(GX,Y).Th.P) /\ Kri':=H(kri.exp(GX,Y).Th.P)
                   /\ request(Rsp,Ini,n_i,Ni)
                   /\ secret(Kir',k_ir,{Ini,Rsp}) /\ secret(Kri',k_ri,{Ini,Rsp})
end role

role session(Ini,Rsp:agent, Psk:symmetric_key, G,P:text, H:hash_func)
def=
        local   SI,RI,SR,RR:channel(dy)
        composition
                initiator(Ini,Rsp,Psk,G,P,H,SI,RI) /\ responder(Ini,Rsp,Psk,G,P,H,SR,RR)
end role

role environment()
def=
        const   a,b:agent,
                kab,kib,kai:symmetric_key,
                g,cm_ch:text,
                kcr,kci,kir,kri,hs2,hs3:text,
                h:hash_func,
                n_i,n_r,k_ir,k_ri:protocol_id
        %% the HKDF/HMAC labels are public strings: the intruder knows them
        intruder_knowledge = {a,b,g,cm_ch,h,kib,kai,kcr,kci,kir,kri,hs2,hs3}
        composition
                session(a,b,kab,g,cm_ch,h)               %% honest - honest
             /\ session(a,b,kab,g,cm_ch,h)               %% a second, parallel honest session
             /\ session(i,b,kib,g,cm_ch,h)               %% intruder as initiator, own PSK with b
             /\ session(a,i,kai,g,cm_ch,h)               %% intruder as responder, own PSK with a
end role

goal
        authentication_on n_i
        authentication_on n_r
        secrecy_of k_ir, k_ri
end goal

environment()
